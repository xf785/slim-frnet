# 统一换行与二进制文件处理
#
# 目的：避免 Windows 上的 CRLF 进入仓库，导致 diff 全是换行噪音，
# 同时保证 PNG / PDF 这类文件不被 Git 当成文本做换行转换。

* text=auto eol=lf

# --- 源码 ---
*.py    text eol=lf
*.toml  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.jsonl text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.qss   text eol=lf

# --- Windows 脚本必须保留 CRLF，否则 cmd 解析会出问题 ---
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.vbs   text eol=crlf

# --- 二进制 ---
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.npz   binary
*.npy   binary

# --- 语言与统计 ---
*.pdf   -diff
docs/screenshots/* linguist-documentation
docs/images/*      linguist-documentation
